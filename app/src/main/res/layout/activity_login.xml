<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050308">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- Premium Header with Royal Gradient -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dcx_header"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="18dp"
                android:paddingTop="52dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dcx_badge_vip"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.12"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="5dp"
                    android:text="PREMIUM &#8226; VIP EDITION"
                    android:textColor="#FFD700"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08"
                    android:text="DCX"
                    android:textColor="#FFFFFF"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-6dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.28"
                    android:text="KING"
                    android:textColor="#FFD700"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Undetected &#8226; Safe &#8226; Premium"
                    android:textColor="#9A93B2"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="20dp"
                    android:contentDescription="DCX KING Emblem"
                    android:scaleType="fitCenter"
                    android:src="@drawable/dcx_logo" />

            </LinearLayout>

            <!-- Premium Login Card -->
            <LinearLayout
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_dcx_card"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="28dp"
                        android:layout_height="1dp"
                        android:background="#3A2E12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.12"
                        android:paddingHorizontal="10dp"
                        android:text="ENTER LICENSE KEY"
                        android:textColor="#FFD700"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="28dp"
                        android:layout_height="1dp"
                        android:background="#3A2E12" />

                </LinearLayout>

                <!-- Premium Input -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_dcx_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Key Icon"
                            android:src="@drawable/ic_key_gold" />

                        <EditText
                            android:id="@+id/userkey"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="Enter key or DCX_OK"
                            android:paddingEnd="12dp"
                            android:paddingStart="12dp"
                            android:singleLine="true"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#6E6884"
                            android:textSize="15sp" />

                        <ImageView
                            android:id="@+id/paste"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Toggle Password / Paste"
                            android:padding="2dp"
                            android:src="@drawable/ic_eye_gold" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:background="#12101F"
                        android:paddingHorizontal="8dp"
                        android:text="License Key"
                        android:textColor="#FFD700"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Tip: Use DCX_OK for instant local access"
                    android:textColor="#6E6884"
                    android:textSize="11sp" />

                <!-- Premium Gold Login Button -->
                <Button
                    android:id="@+id/login"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_dcx_btn_gold"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.10"
                    android:text="LOGIN &#8212; DCX KING"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="1dp"
                        android:background="#2A2438" />

                    <TextView
                        android:id="@+id/GetKey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.06"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="GET LICENSE KEY"
                        android:textColor="#FFD700"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="40dp"
                        android:layout_height="1dp"
                        android:background="#2A2438" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="256-bit Secured &#8226; Anti-Ban &#8226; v4.6"
                    android:textColor="#6E6884"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- Footer -->
            <TextView
                android:id="@+id/footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="Copyright &#169; 2026 - DCX KING&#8482;\nPremium VIP Experience"
                android:textColor="#4A4560"
                android:textSize="11sp" />

        </RelativeLayout>

    </ScrollView>

</RelativeLayout>
